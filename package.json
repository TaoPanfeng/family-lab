{
  "name": "family-lab",
  "version": "1.0.0",
  "private": true,
  "description": "十四个独立探索馆、统一首页、离线优先；科学、人文、语言、编程与音乐交互探索。",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "build": "node tools/build.cjs",
    "build:home": "node tools/build-home.cjs",
    "test": "node tools/test.cjs",
    "test:offline": "node tools/test.cjs --offline",
    "test:portal": "node --test tests/portal.test.cjs",
    "test:browser": "python tests/browser-smoke.py",
    "site": "python tools/prepare-site.py",
    "test:quality": "python tests/quality-browser.py",
    "test:models:quality": "node --test tests/refactor-models.test.cjs",
    "test:math": "node --test tests/math-models.test.cjs",
    "test:math:browser": "python tests/math-browser.py",
    "test:experience": "python tests/experience-browser.py",
    "test:chinese": "node --test tests/chinese-models.test.cjs",
    "test:chinese:browser": "python tests/chinese-browser.py",
    "test:workshops": "node --test tests/workshops-models.test.cjs",
    "test:workshops:browser": "python tests/workshops-browser.py"
  }
}
